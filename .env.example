# Copy these names into your host's environment-variable settings, then replace placeholders locally.
# Do not commit a real .env file or any live credentials.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=PASTE_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=PASTE_SERVICE_ROLE_KEY
ADMIN_PASSWORD=SET_A_NEW_LONG_UNIQUE_PASSWORD
ADMIN_SESSION_SECRET=SET_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
SMM_PROVIDER_URL=https://your-provider.example/api/v2
SMM_PROVIDER_KEY=PASTE_PROVIDER_API_KEY
SMM_MARKUP_PERCENT=0
