{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/config",
      "destination": "/api/config.js"
    },
    {
      "source": "/api/deposits",
      "destination": "/api/deposits.js"
    },
    {
      "source": "/api/order",
      "destination": "/api/order.js"
    },
    {
      "source": "/api/admin-login",
      "destination": "/api/admin-login.js"
    },
    {
      "source": "/api/admin-deposits",
      "destination": "/api/admin-deposits.js"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/signup",
      "destination": "/signup.html"
    },
    {
      "source": "/services",
      "destination": "/services.html"
    },
    {
      "source": "/dashboard",
      "destination": "/dashboard.html"
    },
    {
      "source": "/api-docs",
      "destination": "/api-docs.html"
    },
    {
      "source": "/resetpassword",
      "destination": "/resetpassword.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    }
  ]
}
